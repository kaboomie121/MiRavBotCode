@model DashboardViewModel
@{
    ViewData["Title"] = $"{Model.SelectedGuild?.Name ?? "Select a Server"}";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-6 fw-semibold mb-2">@(Model.SelectedGuild?.Name ?? "Select a Server")</h1>
        <p class="text-muted mb-0">Manage your bot settings and server options</p>
    </div>

    <div class="d-flex justify-content-center mb-5">
        <div class="dropdown">
            <button class="btn btn-dark btn-lg dropdown-toggle d-flex align-items-center gap-2 px-4 py-3 shadow-sm"
                    style="min-width: 320px; border-radius: 14px;"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                @if (Model.SelectedGuild != null)
                {
                    <img src="@Model.SelectedGuild.IconUrl" width="28" height="28" class="rounded-circle" alt="icon" />
                    <span class="fw-medium">@Model.SelectedGuild.Name</span>
                }
                else
                {
                    <span class="fw-medium">Choose a server</span>
                }
            </button>

            <ul class="dropdown-menu shadow border-0 mt-2 p-2" style="min-width: 320px; border-radius: 14px;">
                @foreach (var guild in Model.UserGuilds.Where(x => x.IsBotPresent == true))
                {
                    <li>
                        <a class="dropdown-item d-flex align-items-center justify-content-between gap-2 py-2 px-3 rounded-3"
                           href="?guildId=@guild.Id">
                            <span class="d-flex align-items-center gap-2">
                                <img src="@guild.IconUrl" width="22" height="22" class="rounded-circle" alt="server icon" />
                                <span>@guild.Name</span>
                            </span>

                            @if (!guild.IsBotPresent)
                            {
                                <span class="badge bg-secondary">Not Added</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Bot Present</span>
                            }
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    @if (Model.SelectedGuild != null)
    {
        var canManage = Model.SelectedGuild.CanManageServer;

        <div class="d-flex justify-content-center">
            <div class="row row-cols-1 row-cols-md-2 g-4 justify-content-center" style="max-width: 760px; width: 100%;">
                <div class="col">
                    <button class="btn btn-outline-primary btn-lg w-100 py-4 shadow-sm rounded-4"
                            @(canManage ? "" : "disabled")>SQB</button>
                </div>
                <div class="col">
                    <button class="btn btn-outline-primary btn-lg w-100 py-4 shadow-sm rounded-4"
                            @(canManage ? "" : "disabled")>Moderation</button>
                </div>
                <div class="col">
                    <button class="btn btn-outline-primary btn-lg w-100 py-4 shadow-sm rounded-4"
                            @(canManage ? "" : "disabled")>Events</button>
                </div>
                <div class="col">
                    <button class="btn btn-outline-success btn-lg w-100 py-4 shadow-sm rounded-4">SQB Analyser</button>
                </div>
            </div>
        </div>

        @if (!canManage)
        {
            <div class="text-center text-muted mt-3">
                You only have access to SQB Analyser for this server.
            </div>
        }
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inviteBtn = document.getElementById("inviteBotBtn");
        if (inviteBtn) {
            inviteBtn.addEventListener("click", function () {
                window.addEventListener("focus", function onFocus() {
                    window.removeEventListener("focus", onFocus);
                    setTimeout(function () {
                        window.location.reload();
                    }, 500);
                });
            });
        }
    });
</script>